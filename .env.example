ANTHROPIC_API_KEY=
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=

# Optional. Sends failed evals to a Slack channel: a bot token that can post, and the channel's id.
SLACK_BOT_TOKEN=
SLACK_EVALS_CHANNEL=

# Optional. Saves each eval run as an experiment in the Braintrust project "Buy evals".
BRAINTRUST_API_KEY=

# Optional. Sends each buy conversation to Agnost AI: the organization id from its settings page.
AGNOST_ORG_ID=

# Optional. The daily job that saves real asks that failed (real-asks/pick.ts) reads a day of conversations from the
# backend's database with a read-only login. See "Running the job on a server" in the README for every variable.
# REAL_ASKS_DATABASE_URL=
# REAL_ASKS_DATABASE_CA=
# REAL_ASKS_SKIP_COMPANIES=
# REAL_ASKS_SKIP_CLIENTS=
# REAL_ASKS_SKIP_SHOPPERS=
