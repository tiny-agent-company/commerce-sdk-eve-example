{
  "name": "commerce-sdk-eve-example",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "real-asks": "node real-asks/pick.ts",
    "real-asks:post": "node real-asks/post.ts",
    "test": "node --test \"real-asks/*.test.ts\" \"agent/lib/*.test.ts\" \"evals/lib/*.test.ts\"",
    "start": "eve start",
    "typecheck": "tsc",
    "eval:purchases": "eve eval --tag cart --tag checkout --tag asked-once --tag refused-details --tag store-account --repeat 3 --max-concurrency 15"
  },
  "dependencies": {
    "@agent-cards/commerce-sdk": "^0.33.1",
    "@vercel/connect": "2.5.2",
    "agnostai": "^0.2.2",
    "ai": "^7.0.137",
    "braintrust": "^3.44.0",
    "eve": "^0.90.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
